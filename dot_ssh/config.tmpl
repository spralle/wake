# wake managed dotfile — do not edit directly, use `chezmoi edit`
# SSH client configuration

Host *
    AddKeysToAgent yes
    IdentitiesOnly yes
    ServerAliveInterval 60
    ServerAliveCountMax 3

{{ if eq .chezmoi.os "darwin" -}}
Host *
    UseKeychain yes
{{ end -}}

