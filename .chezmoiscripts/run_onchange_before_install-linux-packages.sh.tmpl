{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Install Linux packages on Arch and Debian-family distributions.
# This script runs when packages/linux-packages.tsv changes.
# hash: {{ include "packages/linux-packages.tsv" | sha256sum }}

set -euo pipefail

PACKAGE_FILE={{ joinPath .chezmoi.sourceDir "packages/linux-packages.tsv" | quote }}
MISE_CONFIG_FILE={{ joinPath .chezmoi.sourceDir "dot_config/mise/config.toml" | quote }}
OS_RELEASE_FILE="${OS_RELEASE_FILE:-/etc/os-release}"
LOCAL_BIN="${HOME}/.local/bin"

portable_metadata() {
    local tool=$1
    awk -v tool="$tool" -v checksum_column="$checksum_column" \
        '$1 == tool { print $4, $checksum_column }' "$PACKAGE_FILE"
}

install_binary_archive() (
    local url=$1 member=$2 destination=$3 checksum=$4
    local temp_dir archive
    temp_dir=$(mktemp -d)
    trap 'rm -rf "$temp_dir"' EXIT
    archive="$temp_dir/archive.tar.gz"
    curl -fsSL "$url" -o "$archive"
    printf '%s  %s\n' "$checksum" "$archive" | sha256sum -c -
    tar -xzf "$archive" -C "$temp_dir" "$member"
    install -m 0755 "$temp_dir/$member" "$destination"
)

install_portable_tools() {
    local version checksum archive url

    read -r version checksum <<< "$(portable_metadata starship)"
    archive="starship-${starship_arch}-unknown-linux-musl.tar.gz"
    url="https://github.com/starship/starship/releases/download/v${version}/${archive}"
    install_binary_archive "$url" starship "$LOCAL_BIN/starship" "$checksum"

    read -r version checksum <<< "$(portable_metadata mise)"
    archive="mise-v${version}-linux-${mise_arch}.tar.gz"
    url="https://github.com/jdx/mise/releases/download/v${version}/${archive}"
    install_binary_archive "$url" mise/bin/mise "$LOCAL_BIN/mise" "$checksum"

    read -r version checksum <<< "$(portable_metadata lazygit)"
    archive="lazygit_${version}_linux_${lazygit_arch}.tar.gz"
    url="https://github.com/jesseduffield/lazygit/releases/download/v${version}/${archive}"
    install_binary_archive "$url" lazygit "$LOCAL_BIN/lazygit" "$checksum"
}

install_neovim() (
    local version checksum archive url temp_dir install_dir
    read -r version checksum <<< "$(portable_metadata neovim)"
    archive="nvim-linux-${neovim_arch}.tar.gz"
    url="https://github.com/neovim/neovim/releases/download/v${version}/${archive}"
    temp_dir=$(mktemp -d)
    trap 'rm -rf "$temp_dir"' EXIT
    curl -fsSL "$url" -o "$temp_dir/$archive"
    printf '%s  %s\n' "$checksum" "$temp_dir/$archive" | sha256sum -c -
    tar -xzf "$temp_dir/$archive" -C "$temp_dir"
    install_dir="$HOME/.local/lib/nvim"
    rm -rf "$install_dir"
    mkdir -p "$(dirname "$install_dir")"
    mv "$temp_dir/${archive%.tar.gz}" "$install_dir"
    ln -sf "$install_dir/bin/nvim" "$LOCAL_BIN/nvim"
)

if [[ ! -r "$OS_RELEASE_FILE" ]]; then
    echo "Cannot detect Linux distribution: $OS_RELEASE_FILE is missing." >&2
    exit 1
fi

# shellcheck disable=SC1090
source "$OS_RELEASE_FILE"

case " ${ID:-} ${ID_LIKE:-} " in
    *" arch "*)
        package_column=2
        package_manager="pacman"
        ;;
    *" debian "*|*" ubuntu "*)
        package_column=3
        package_manager="apt"
        ;;
    *)
        echo "Unsupported Linux distribution: ${PRETTY_NAME:-${ID:-unknown}}" >&2
        exit 1
        ;;
esac

case "$(uname -m)" in
    x86_64)
        checksum_column=5
        starship_arch=x86_64
        mise_arch=x64
        lazygit_arch=x86_64
        neovim_arch=x86_64
        ;;
    aarch64|arm64)
        checksum_column=6
        starship_arch=aarch64
        mise_arch=arm64
        lazygit_arch=arm64
        neovim_arch=arm64
        ;;
    *)
        echo "Unsupported architecture: $(uname -m)" >&2
        exit 1
        ;;
esac

if (( EUID == 0 )); then
    sudo_cmd=()
elif command -v sudo >/dev/null 2>&1; then
    sudo_cmd=(sudo)
else
    echo "Package installation requires root or sudo." >&2
    exit 1
fi

mapfile -t packages < <(
    awk -v column="$package_column" '!/^#/ && NF >= column && $column != "-" { print $column }' "$PACKAGE_FILE"
)

echo "Installing packages with $package_manager..."
if [[ "$package_manager" == "pacman" ]]; then
    "${sudo_cmd[@]}" pacman -Syu --needed --noconfirm "${packages[@]}"
else
    "${sudo_cmd[@]}" apt-get update
    "${sudo_cmd[@]}" env DEBIAN_FRONTEND=noninteractive apt-get install -y "${packages[@]}"
fi

mkdir -p "$LOCAL_BIN"
export PATH="$LOCAL_BIN:$PATH"

if [[ "$package_manager" == "apt" ]]; then
    # Debian renames these binaries to avoid collisions with other packages.
    command -v fd >/dev/null 2>&1 || ln -sf "$(command -v fdfind)" "$LOCAL_BIN/fd"
    command -v bat >/dev/null 2>&1 || ln -sf "$(command -v batcat)" "$LOCAL_BIN/bat"

    install_portable_tools
    install_neovim
fi

if command -v mise >/dev/null 2>&1; then
    MISE_CONFIG_FILE="$MISE_CONFIG_FILE" mise install
fi

if command -v fc-cache >/dev/null 2>&1; then
    fc-cache -f
fi

echo "Package installation complete."
{{- end }}
