{{- if eq .chezmoi.os "linux" }}
#!/bin/bash
# Install Arch Linux packages
# This script runs when packages/arch-packages.txt changes
# hash: {{ include "packages/arch-packages.txt" | sha256sum }}

set -euo pipefail

echo "Installing Arch Linux packages..."

# Read package list, skip comments and empty lines
while IFS= read -r pkg; do
    pkg=$(echo "$pkg" | sed 's/#.*//' | xargs)
    [ -z "$pkg" ] && continue
    if ! pacman -Qi "$pkg" &>/dev/null; then
        echo "Installing $pkg..."
        sudo pacman -S --noconfirm "$pkg"
    fi
done < "{{ .chezmoi.sourceDir }}/packages/arch-packages.txt"

echo "Package installation complete."
{{- end }}
