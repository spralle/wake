# Default to LF
* text=auto eol=lf

# Force LF for shell scripts and unix configs
*.sh text eol=lf
*.zsh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.lua text eol=lf
*.tmpl text eol=lf

# Force CRLF for Windows-specific files
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.exe binary
*.zip binary
*.age binary
